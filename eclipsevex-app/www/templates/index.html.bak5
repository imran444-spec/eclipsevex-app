/* ══════════════════════════════════════════════
   API HELPER
══════════════════════════════════════════════ */
async function apiCall(endpoint, data){
  try {
    const res = await fetch(endpoint, {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(data),
    });
    if(res.status === 404 || res.status === 405) {
      return { success:true, simulated:true };
    }
    if(res.ok) return await res.json();
    const err = await res.json().catch(()=>({}));
    return { success:false, error: err.error || 'Authentication failed. Please try again.' };
  } catch(e) {
    return { success:true, simulated:true };
  }
}

/* ══════════════════════════════════════════════
   SHARED MODAL HELPERS
══════════════════════════════════════════════ */
function showErr(id, msg){ const el=document.getElementById(id); el.textContent=msg; el.classList.add('show'); }
function hideErr(id){ document.getElementById(id).classList.remove('show'); }

/* ══════════════════════════════════════════════
   SIGN UP
══════════════════════════════════════════════ */
function openSignup(){
  document.getElementById('signup-success').classList.remove('show');
  document.getElementById('signup-form').classList.remove('hide');
  hideErr('su-err');
  const btn=document.getElementById('su-btn'); btn.disabled=false; btn.textContent='Create Free Account';
  document.getElementById('signup-modal').classList.add('open');
  setTimeout(()=>document.getElementById('su-fn').focus(), 120);
}
function closeSignup(){ document.getElementById('signup-modal').classList.remove('open'); }
document.getElementById('signup-modal').addEventListener('click', e=>{ if(e.target===document.getElementById('signup-modal')) closeSignup(); });

async function doSignup(){
  const fn = document.getElementById('su-fn').value.trim();
  const ln = document.getElementById('su-ln').value.trim();
  const em = document.getElementById('su-em').value.trim();
  const pw = document.getElementById('su-pw').value;
  hideErr('su-err');
  if(!fn){ showErr('su-err','Please enter your first name.'); document.getElementById('su-fn').focus(); return; }
  if(!em||!em.includes('@')){ showErr('su-err','Please enter a valid email address.'); document.getElementById('su-em').focus(); return; }
  if(pw.length<8){ showErr('su-err','Password must be at least 8 characters.'); document.getElementById('su-pw').focus(); return; }

  const btn = document.getElementById('su-btn');
  btn.disabled=true; btn.textContent='Creating Account…';

  const result = await apiCall('/api/signup', { first_name:fn, last_name:ln, email:em, password:pw });

  if(result.success === false){
    btn.disabled=false; btn.textContent='Create Free Account';
    showErr('su-err', result.error || 'Signup failed. Please try again.');
    return;
  }

  document.getElementById('signup-success-text').textContent = `Welcome, ${fn}! Opening your dashboard…`;
  document.getElementById('signup-form').classList.add('hide');
  document.getElementById('signup-success').classList.add('show');

  currentUser = { name:`${fn} ${ln}`.trim(), email:em, initials:(fn[0]+(ln?ln[0]:'')).toUpperCase() };
  setTimeout(()=>{ closeSignup(); launchApp(); }, 1600);
}

/* ══════════════════════════════════════════════
   SIGN IN
══════════════════════════════════════════════ */
function openSignin(){
  document.getElementById('signin-success').classList.remove('show');
  document.getElementById('signin-form').classList.remove('hide');
  hideErr('si-err');
  const btn=document.getElementById('si-btn'); btn.disabled=false; btn.textContent='Sign In';
  document.getElementById('signin-modal').classList.add('open');
  setTimeout(()=>document.getElementById('si-em').focus(), 120);
}
function closeSignin(){ document.getElementById('signin-modal').classList.remove('open'); }
document.getElementById('signin-modal').addEventListener('click', e=>{ if(e.target===document.getElementById('signin-modal')) closeSignin(); });

async function doSignin(){
  const em = document.getElementById('si-em').value.trim();
  const pw = document.getElementById('si-pw').value;
  hideErr('si-err');
  if(!em||!em.includes('@')){ showErr('si-err','Please enter a valid email address.'); document.getElementById('si-em').focus(); return; }
  if(!pw){ showErr('si-err','Please enter your password.'); document.getElementById('si-pw').focus(); return; }

  const btn = document.getElementById('si-btn');
  btn.disabled=true; btn.textContent='Signing in…';

  const result = await apiCall('/api/login', { email:em, password:pw });

  if(result.success === false){
    btn.disabled=false; btn.textContent='Sign In';
    showErr('si-err', result.error || 'Invalid credentials. Please try again.');
    return;
  }

  const name = result.name || em.split('@')[0];
  const initials = name.split(' ').map(p=>p[0]).join('').toUpperCase().slice(0,2);

  document.getElementById('signin-success-text').textContent = `Welcome back, ${name}! Opening your dashboard…`;
  document.getElementById('signin-form').classList.add('hide');
  document.getElementById('signin-success').classList.add('show');

  currentUser = { name, email:em, initials };
  setTimeout(()=>{ closeSignin(); launchApp(); }, 1400);
}

function doForgot(){
  const em = document.getElementById('si-em').value.trim();
  if(em&&em.includes('@')){ toast(`Password reset link sent to ${em}`); }
  else { showErr('si-err','Enter your email above first, then click "Forgot password?"'); }
}

/* ══════════════════════════════════════════════
   LAUNCH APP
══════════════════════════════════════════════ */
function launchApp(){
  document.getElementById('landing').classList.add('hidden');
  document.getElementById('gbg').classList.add('hidden');
  const app = document.getElementById('app');
  app.classList.add('active');

  document.getElementById('user-avatar-initials').textContent = currentUser.initials;
  document.getElementById('user-display-name').textContent = currentUser.name;
  document.getElementById('welcome-sub').textContent =
    `Welcome, ${currentUser.name.split(' ')[0]}! I'm ECLIPSEVEX AI — 1.8T parameters, 2M token context, 14ms latency.`;

  newChat();
  document.getElementById('chat-input').focus();
}

function signOut(){
  currentUser = null; messages = []; chatHistory = []; activeChatId = null;
  attachedFile = null;
  document.getElementById('file-chip').classList.remove('show');
  document.getElementById('landing').classList.remove('hidden');
  document.getElementById('gbg').classList.remove('hidden');
  document.getElementById('app').classList.remove('active');
  ['su-fn','su-ln','su-em','su-pw','si-em','si-pw'].forEach(id=>{ const el=document.getElementById(id); if(el) el.value=''; });
}

/* ══════════════════════════════════════════════
   CHAT — SIDEBAR
══════════════════════════════════════════════ */
let sidebarOpen = true;
function toggleSidebar(){
  const sb = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const closeBtn = document.getElementById('sidebar-close-btn');
  if(window.innerWidth <= 768){
    sb.classList.toggle('open');
    overlay.classList.toggle('open');
    closeBtn.style.display = sb.classList.contains('open') ? 'flex' : 'none';
  } else {
    sidebarOpen = !sidebarOpen;
    sb.style.display = sidebarOpen ? '' : 'none';
  }
}
function closeSidebar(){
  const sb = document.getElementById('sidebar');
  sb.classList.remove('open');
  document.getElementById('sidebar-overlay').classList.remove('open');
  document.getElementById('sidebar-close-btn').style.display='none';
}

function renderSidebarChats(){
  const container = document.getElementById('sidebar-chats');
  if(chatHistory.length===0){ container.innerHTML='<div style="padding:10px 12px;font-size:.8rem;color:var(--fg3)">No chats yet</div>'; return; }
  container.innerHTML = chatHistory.map(ch=>`
    <button class="chat-item${ch.id===activeChatId?' active':''}" onclick="loadChat('${ch.id}')">
      <svg class="chat-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <span class="chat-item-text">${ch.title}</span>
      <span class="chat-item-time">${ch.time}</span>
    </button>`).join('');
}

function loadChat(id){
  activeChatId = id;
  const ch = chatHistory.find(c=>c.id===id);
  messages = ch ? (ch.messages||[]) : [];
  renderMessages();
  renderSidebarChats();
  if(window.innerWidth<=768) closeSidebar();
}

/* ══════════════════════════════════════════════
   CHAT — NEW CHAT
══════════════════════════════════════════════ */
function newChat(){
  activeChatId = 'chat_' + Date.now();
  messages = [];
  const chatMsgs = document.getElementById('chat-messages');
  const chatWelcome = document.getElementById('chat-welcome');
  chatMsgs.style.display='none';
  chatWelcome.style.display='flex';
  chatMsgs.innerHTML='';
  renderSidebarChats();
}

/* ══════════════════════════════════════════════
   CHAT — RENDER MESSAGES
══════════════════════════════════════════════ */
function renderMessages(){
  const container = document.getElementById('chat-messages');
  const welcome = document.getElementById('chat-welcome');
  if(messages.length===0){
    container.style.display='none';
    welcome.style.display='flex';
    return;
  }
  container.style.display='flex';
  welcome.style.display='none';
  container.innerHTML = messages.map(m=>{
    const isUser = m.role==='user';
    const imgHtml = m.imgSrc ? `<img src="${m.imgSrc}" style="max-width:90px;max-height:90px;object-fit:cover;border-radius:8px;margin-top:6px;display:block;cursor:pointer" onclick="this.style.maxWidth=this.style.maxWidth==='90px'?'100%':'90px';this.style.maxHeight=this.style.maxHeight==='90px'?'none':'90px'" title="Click to expand"/>` : '';
    return `<div class="chat-msg ${isUser?'user-msg':'ai-msg'}">
      ${!isUser?`<div class="msg-avatar ai-av">EV</div>`:''}
      <div class="msg-content">
        <div class="msg-bubble">${m.text.replace(/\n/g,'<br/>')}${imgHtml}</div>
        <div class="msg-time">${m.time}</div>
      </div>
      ${isUser?`<div class="msg-avatar user-av">${currentUser?currentUser.initials:'U'}</div>`:''}
    </div>`;
  }).join('');
  container.scrollTop = container.scrollHeight;
}

let thinkingStages = ['Thinking...', 'Analyzing your request...', 'Generating response...'];
let thinkingTimer = null;

function addTypingIndicator(userText){
  const container = document.getElementById('chat-messages');
  const el = document.createElement('div');
  el.className = 'chat-msg ai-msg ai-typing'; el.id = 'typing-indicator';

  const lc = (userText||'').toLowerCase();
  let stages = ['Thinking...', 'Analyzing your request...', 'Generating response...'];
  if(/code|script|function|debug|error|fix|bug|python|javascript|html|css|api/.test(lc)){
    stages = ['Thinking...', 'Reading your code...', 'Debugging...', 'Writing code...'];
  }
  thinkingStages = stages;

  el.innerHTML = `<div class="msg-avatar ai-av">EV</div><div class="msg-content"><div class="msg-bubble" style="display:flex;align-items:center;gap:10px"><span class="typing-dots-inline"><span></span><span></span><span></span></span><span id="thinking-label" style="font-size:.82rem;color:var(--fg3)">${stages[0]}</span></div></div>`;
  container.appendChild(el);
  container.scrollTop = container.scrollHeight;

  let idx = 0;
  thinkingTimer = setInterval(()=>{
    idx = (idx+1) % thinkingStages.length;
    const label = document.getElementById('thinking-label');
    if(label) label.textContent = thinkingStages[idx];
  }, 1400);
}

function removeTypingIndicator(){ if(thinkingTimer){ clearInterval(thinkingTimer); thinkingTimer=null; } const el=document.getElementById('typing-indicator'); if(el) el.remove(); }

/* ══════════════════════════════════════════════
   CHAT — AI RESPONSE ENGINE
══════════════════════════════════════════════ */
const AI_KB = {
  hello:   'Hello! All 4,096 inference nodes are online. I\'m ready to assist with anything.',
  hi:      'Hi there! ECLIPSEVEX AI at your service. What can I help you with today?',
  python:  'Here\'s a clean Python approach:\n\n```python\nimport requests\nfrom bs4 import BeautifulSoup\n\ndef scrape(url):\n    soup = BeautifulSoup(requests.get(url).text, \'html.parser\')\n    return [a.text for a in soup.find_all(\'a\')]\n```\n\nRun `pip install requests beautifulsoup4` first.',
  code:    'I can write, review, debug, and deploy code in 47 languages. What would you like me to build?',
  email:   'Subject: Introducing [Product] — A New Way to [Core Benefit]\n\nHi [Name],\n\nWe\'re thrilled to announce the launch of [Product]. It solves [problem] by [solution].\n\nKey benefits:\n• [Benefit 1]\n• [Benefit 2]\n• [Benefit 3]\n\nTry it free at [link]\n\nBest,\n[Your Name]',
  quantum: 'Quantum computing uses quantum bits (qubits) that can exist in superposition — both 0 and 1 simultaneously — unlike classical bits. This lets quantum computers solve certain problems exponentially faster, especially in cryptography, drug discovery, and optimization.',
  strategy:'To analyze your business strategy, I\'ll need more context:\n\n1. What market are you in?\n2. Who are your main competitors?\n3. What\'s your current growth rate?\n4. What\'s your biggest bottleneck?\n\nShare these details and I\'ll give you a thorough strategic analysis.',
  pricing: 'ECLIPSEVEX plans:\n• Free — 500K tokens/mo, no card\n• Spark — $49/mo, 5M tokens\n• Nova — $299/mo, 100M tokens (most popular)\n• Sovereign — Custom, unlimited\n\nAll plans include the full model. Upgrade anytime.',
  free:    'The Free tier includes 500K tokens/month, 1 API key, text and code modalities — absolutely free, forever. No credit card required.',
  help:    'I can help you with:\n• Code — Write, debug, review in 47 languages\n• Writing — Emails, docs, summaries, creative\n• Analysis — Data, strategy, research\n• Math — Calculations, proofs, explanations\n• Q&A — Answer any question\n\nWhat do you need?',
};

function getAIReply(text){
  const lc = (text||'').toLowerCase();
  const key = Object.keys(AI_KB).find(k=>lc.includes(k));
  if(key) return AI_KB[key];
  const generics = [
    `That's an interesting question about "${(text||'').slice(0,40)}${(text||'').length>40?'...':''}". With my 2M token context and 1.8T parameters, here's my analysis:\n\nThis topic involves several key considerations. The most important factors are accuracy, context, and practical applicability. I'd recommend approaching this systematically — would you like me to break it down step by step?`,
    `Great question! Based on my training data and reasoning capabilities, I can offer a comprehensive perspective on this.\n\nThe core insight here is that context matters enormously. Without more specific details, I'd suggest considering multiple angles before drawing conclusions. Want me to elaborate on any specific aspect?`,
    `I've analyzed your message. Here's what I think:\n\nThe question touches on some nuanced territory. My recommendation would be to start with the fundamentals and build from there. I can generate detailed analysis, code, writing, or research on this topic — just let me know the depth you need.`,
  ];
  return generics[Math.floor(Math.random()*generics.length)];
}

/* ══════════════════════════════════════════════
   ATTACH FILE
══════════════════════════════════════════════ */
function handlePaste(e){
  const text = (e.clipboardData || window.clipboardData).getData('text');
  if(!text) return;
  const lineCount = text.split('\n').length;
  if(lineCount > PASTE_LINE_THRESHOLD){
    e.preventDefault();
    const ext = /def |import |function |const |class |<html|#include/.test(text) ? guessExt(text) : 'txt';
    attachedText = { name: `pasted-code.${ext}`, content: text, lines: lineCount };
    document.getElementById('file-chip-icon').innerHTML =
      '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/>';
    document.getElementById('file-chip-name').textContent =
      `${attachedText.name} · ${lineCount} lines`;
    document.getElementById('file-chip').classList.add('show');
  }
}
function guessExt(text){
  if(/def |import \w+|print\(/.test(text)) return 'py';
  if(/function |const |let |=>/.test(text)) return 'js';
  if(/<html|<div|<\/\w+>/.test(text)) return 'html';
  if(/#include|int main/.test(text)) return 'cpp';
  return 'txt';
}

function handleAttach(input){
  const file = input.files[0];
  if(!file) return;
  attachedFile = file;
  document.getElementById('file-chip-name').textContent = file.name;
  document.getElementById('file-chip').classList.add('show');
  input.value = '';
}
function removeAttach(){
  attachedFile = null;
  attachedText = null;
  document.getElementById('file-chip').classList.remove('show');
  document.getElementById('file-chip-name').textContent = '';
  document.getElementById('file-chip-icon').innerHTML =
    '<path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>';
}

function maybeOpenPreview(){
  if(!attachedText) return;
  document.getElementById('cp-filename').textContent = attachedText.name;
  document.getElementById('cp-linecount').textContent = attachedText.lines + ' lines';
  document.getElementById('cp-content').textContent = attachedText.content;
  document.getElementById('code-preview-modal').classList.add('open');
}
function closeCodePreview(){
  document.getElementById('code-preview-modal').classList.remove('open');
}
document.getElementById('code-preview-modal').addEventListener('click', e=>{
  if(e.target===document.getElementById('code-preview-modal')) closeCodePreview();
});

/* ══════════════════════════════════════════════
   CHAT — SEND MESSAGE
══════════════════════════════════════════════ */
function nowTime(){
  return new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
}

async function sendMessage(){
  if(isWaiting) return;
  const inp = document.getElementById('chat-input');
  let text = inp.value.trim();
  if(!text && !attachedFile && !attachedText) return;

  inp.value=''; autoResize(inp);

  const fileRef = attachedFile;
  const textRef = attachedText;
  removeAttach();

  if(textRef){
    text = text
      ? `${text}\n\n[Attached file: ${textRef.name}]\n\`\`\`\n${textRef.content}\n\`\`\``
      : `[Attached file: ${textRef.name}]\n\`\`\`\n${textRef.content}\n\`\`\``;
  }

  const container = document.getElementById('chat-messages');
  const welcome   = document.getElementById('chat-welcome');
  container.style.display='flex';
  welcome.style.display='none';

  const userText = text || (fileRef ? fileRef.name : '');

  // Read image for preview before sending
  let imgSrc = null;
  if(fileRef && fileRef.type.startsWith('image/')){
    imgSrc = await new Promise(resolve=>{
      const r = new FileReader();
      r.onload = e => resolve(e.target.result);
      r.readAsDataURL(fileRef);
    });
  }

  messages.push({ role:'user', text:userText, time:nowTime(), imgSrc });

  const existing = chatHistory.find(c=>c.id===activeChatId);
  const title = userText.slice(0,36)+(userText.length>36?'…':'');
  if(existing){ existing.messages=messages; }
  else { chatHistory.unshift({ id:activeChatId, title, time:'now', messages:[...messages] }); }
  renderMessages();
  renderSidebarChats();

  isWaiting=true;
  const sendBtn=document.getElementById('chat-send');
  sendBtn.disabled=true;
  sendBtn.classList.add('busy');
  document.getElementById('send-icon').style.display='none';
  document.getElementById('send-icon-busy').style.display='block';
  addTypingIndicator(userText);
  container.scrollTop=container.scrollHeight;

  // Build request — FormData for images, JSON for text
  let aiText = '';

  if(fileRef){
    try {
      const fd = new FormData();
      fd.append('message', text || 'What is in this image?');
      fd.append('image', fileRef);
      const res = await fetch('/chat', { method:'POST', body:fd });
      if(res && res.ok){ const d=await res.json(); aiText=d.reply||d.message||getAIReply(text); }
      else aiText = getAIReply(text);
    } catch(e){ aiText = getAIReply(text); }
    await new Promise(r=>setTimeout(r,400+Math.random()*400));
    removeTypingIndicator();
    messages.push({ role:'ai', text:aiText, time:nowTime() });
    const chF = chatHistory.find(c=>c.id===activeChatId);
    if(chF) chF.messages=[...messages];
    renderMessages();
    const bsF = container.querySelectorAll('.chat-msg.ai-msg .msg-bubble');
    const lbF = bsF[bsF.length-1];
    if(lbF){
      lbF.innerHTML='';
      const cur=document.createElement('span'); cur.className='tw-cursor'; lbF.appendChild(cur);
      const words=aiText.split(' '); let wi=0;
      (function nw(){ if(wi<words.length){ lbF.insertBefore(document.createTextNode((wi?'':'')+words[wi++]),cur); container.scrollTop=container.scrollHeight; setTimeout(nw,35+Math.random()*25); } else { cur.remove(); lbF.innerHTML=(typeof marked!=='undefined')?marked.parse(aiText):aiText; } })();
    }
    renderSidebarChats(); isWaiting=false; resetSendButton();
  } else {
    // Streaming SSE — first word appears in ~2s
    let firstToken=true, lastBubble=null, sseBuffer='';
    try {
      const res = await fetch('/api/chat/stream', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body:JSON.stringify({ message:text, history:messages.slice(-10) }),
      });
      if(!res.ok) throw new Error('stream error');
      const reader=res.body.getReader(), dec=new TextDecoder();
      while(true){
        const {done,value}=await reader.read();
        if(done) break;
        sseBuffer += dec.decode(value,{stream:true});
        const lines=sseBuffer.split('\n'); sseBuffer=lines.pop();
        for(const line of lines){
          if(!line.startsWith('data: ')) continue;
          try {
            const d=JSON.parse(line.slice(6));
            container.scrollTop = container.scrollHeight;
            if(d.t!==undefined){
              if(firstToken){
                firstToken=false;
                removeTypingIndicator();
                messages.push({ role:'ai', text:'', time:nowTime() });
                const ch=chatHistory.find(c=>c.id===activeChatId);
                if(ch) ch.messages=[...messages];
                renderMessages();
                const bs=container.querySelectorAll('.chat-msg.ai-msg .msg-bubble');
                lastBubble=bs[bs.length-1];
                if(lastBubble) lastBubble.textContent='';
              }
              aiText+=d.t;
              if(lastBubble){ lastBubble.textContent=aiText; container.scrollTop=container.scrollHeight; }
            }
            if(d.done && lastBubble){
              lastBubble.innerHTML=(typeof marked!=='undefined')?marked.parse(aiText):aiText;
            }
          } catch(e){}
        }
      }
      if(firstToken) throw new Error('no tokens');
    } catch(e){
      aiText=getAIReply(text);
      removeTypingIndicator();
      messages.push({ role:'ai', text:aiText, time:nowTime() });
      const ch=chatHistory.find(c=>c.id===activeChatId);
      if(ch) ch.messages=[...messages];
      renderMessages();
      const bs=container.querySelectorAll('.chat-msg.ai-msg .msg-bubble');
      const lb2=bs[bs.length-1];
      if(lb2){
        lb2.innerHTML='';
        const cur=document.createElement('span'); cur.className='tw-cursor'; lb2.appendChild(cur);
        const words=aiText.split(' '); let wi=0;
        (function nw(){ if(wi<words.length){ lb2.insertBefore(document.createTextNode((wi?'':'')+words[wi++]),cur); container.scrollTop=container.scrollHeight; setTimeout(nw,35+Math.random()*25); } else { cur.remove(); lb2.innerHTML=(typeof marked!=='undefined')?marked.parse(aiText):aiText; } })();
      }
    }
    const lastMsg=messages[messages.length-1];
    if(lastMsg&&lastMsg.role==='ai') lastMsg.text=aiText;
    const ch2=chatHistory.find(c=>c.id===activeChatId);
    if(ch2) ch2.messages=[...messages];
    renderSidebarChats(); isWaiting=false; resetSendButton();
  }
}

function resetSendButton(){
  const sendBtn=document.getElementById('chat-send');
  sendBtn.disabled=false;
  sendBtn.classList.remove('busy');
  document.getElementById('send-icon').style.display='block';
  document.getElementById('send-icon-busy').style.display='none';
}

function sendPrompt(text){
  document.getElementById('chat-input').value = text;
  sendMessage();
}

function handleKey(e){
  if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); sendMessage(); }
}
function autoResize(el){
  el.style.height='auto';
  el.style.height=Math.min(el.scrollHeight,200)+'px';
}

/* ══════════════════════════════════════════════
   ESCAPE KEY
══════════════════════════════════════════════ */
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'){
    closeSignup(); closeSignin(); closeDemo();
    closeSidebar();
  }
});

/* ==============================
   VOICE INPUT (Web Speech API)
============================== */
let recognition = null;
let micActive = false;

function toggleMic(){
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  if(!SpeechRecognition){
    toast('Voice input not supported in this browser. Try Chrome.');
    return;
  }
  const micBtn = document.getElementById('mic-btn');
  if(micActive){
    if(recognition) recognition.stop();
    return;
  }
  recognition = new SpeechRecognition();
  recognition.lang = 'en-US';
  recognition.interimResults = true;
  recognition.continuous = false;

  const inp = document.getElementById('chat-input');
  const baseText = inp.value;

  recognition.onstart = ()=>{
    micActive = true;
    micBtn.style.color = '#ef4444';
    micBtn.style.borderColor = '#ef4444';
    toast('Listening...');
  };
  recognition.onresult = (e)=>{
    let interim = '';
    for(let i=e.resultIndex; i<e.results.length; i++){
      interim += e.results[i][0].transcript;
    }
    inp.value = (baseText ? baseText + ' ' : '') + interim;
    autoResize(inp);
  };
  recognition.onerror = (e)=>{
    toast('Voice input error: ' + e.error);
  };
  recognition.onend = ()=>{
    micActive = false;
    micBtn.style.color = '';
    micBtn.style.borderColor = '';
  };
  try {
    recognition.start();
  } catch(err){
    toast('Mic blocked: this page must be HTTPS (or localhost) for voice input.');
  }
}

</script>
</body>
</html>
