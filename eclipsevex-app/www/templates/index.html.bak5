const TERM_LINES = [
  {t:'> ECLIPSEVEX neural core v4.2.0 initialized', hi:false},
  {t:'> Loading multimodal inference engine...', hi:false},
  {t:'> Context window: 2,048,000 tokens active', hi:false},
  {t:'> Threat detection module: ACTIVE', hi:true},
  {t:'> Latency benchmark: 14ms p99', hi:false},
  {t:'> ECLIPSEVEX AI — all systems nominal', hi:true},
];
let termIdx = 0;
function termTick(){
  if(termIdx >= TERM_LINES.length) return;
  const body = document.getElementById('term-body');
  const cursor = body.querySelector('.term-cursor');
  const line = TERM_LINES[termIdx];
  const el = document.createElement('div');
  el.className = 'term-line' + (line.hi ? ' hi' : '');
  el.textContent = line.t;
  body.insertBefore(el, cursor);
  termIdx++;
  if(termIdx < TERM_LINES.length) setTimeout(termTick, 640);
}
setTimeout(termTick, 800);
window.addEventListener('load', ()=>{
  setTimeout(()=>{ const f=document.getElementById('hero-progress'); if(f) f.style.width='87%'; }, 900);
});

/* ══════════════════════════════════════════════
   STAT COUNTERS
══════════════════════════════════════════════ */
document.querySelectorAll('[data-target]').forEach(el=>{
  const ob = new IntersectionObserver(([e])=>{
    if(!e.isIntersecting) return;
    const tar=parseInt(el.dataset.target), suf=el.dataset.suffix||'';
    let start=null; const dur=1800;
    function tick(now){ if(!start) start=now; const p=Math.min((now-start)/dur,1), ease=1-Math.pow(1-p,3); el.textContent=Math.floor(ease*tar)+suf; if(p<1) requestAnimationFrame(tick); }
    requestAnimationFrame(tick);
    ob.unobserve(el);
  },{threshold:.2});
  ob.observe(el);
});

