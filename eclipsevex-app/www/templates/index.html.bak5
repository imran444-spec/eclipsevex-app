<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>ECLIPSEVEX AI</title>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
/* ═══════════════════════════════════════════════
   THEME TOKENS
═══════════════════════════════════════════════ */
:root{
  --violet:#7c3aed;--cyan:#00e5ff;--green:#22c55e;
  --orb:'Orbitron',monospace;--raj:'Rajdhani',sans-serif;
  --int:'Inter',sans-serif;--mono:'JetBrains Mono',monospace;
}
[data-theme="dark"]{
  --bg:#04040f;--bg2:#080818;--bg3:#0d0d2b;
  --surface:#0f0f28;--surface2:#161635;--surface3:#1e1e45;
  --border:rgba(124,58,237,.22);--border2:rgba(255,255,255,.06);
  --fg:#e8eaf6;--fg2:#a5b4fc;--fg3:#6b7280;
  --shadow:rgba(0,0,0,.5);
}
[data-theme="light"]{
  --bg:#f5f5ff;--bg2:#ededff;--bg3:#e6e6fc;
  --surface:#ffffff;--surface2:#f0f0ff;--surface3:#e8e8fc;
  --border:rgba(124,58,237,.18);--border2:rgba(0,0,0,.07);
  --fg:#1a1a3e;--fg2:#4c1d95;--fg3:#6b7280;
  --shadow:rgba(124,58,237,.12);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;height:100%}
body{background:var(--bg);color:var(--fg);font-family:var(--int);overflow-x:hidden;min-height:100dvh;transition:background .25s,color .25s}
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-thumb{background:rgba(124,58,237,.3);border-radius:4px}
button{cursor:pointer}
input,textarea{font-family:var(--int)}
a{text-decoration:none;color:inherit}

/* ═══════════════════════════════════════════════
   UTILITY
═══════════════════════════════════════════════ */
.gt{background:linear-gradient(90deg,#a78bfa,#00e5ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.gth{background:linear-gradient(90deg,#c4b5fd,#00e5ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.card{background:var(--surface);border-radius:16px;border:1px solid var(--border);backdrop-filter:blur(12px)}
.z1{position:relative;z-index:1}
.hidden{display:none!important}
.fu{opacity:0;transform:translateY(24px);transition:opacity .5s ease,transform .5s ease}
.fu.vi{opacity:1;transform:translateY(0)}
.dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--cyan);animation:pulse 1.4s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.8)}}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@keyframes slideUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes toastIn{from{transform:translateY(16px);opacity:0}to{transform:translateY(0);opacity:1}}
@keyframes tw-blink{0%,100%{opacity:1}50%{opacity:0}}
.tw-cursor{display:inline-block;width:2px;height:1em;background:currentColor;vertical-align:text-bottom;margin-left:2px;animation:tw-blink .7s step-end infinite}

/* ═══════════════════════════════════════════════
   LANDING — GRID BG
═══════════════════════════════════════════════ */
#gbg{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
#gbg::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(124,58,237,.4) 1px,transparent 1px),linear-gradient(90deg,rgba(124,58,237,.4) 1px,transparent 1px);background-size:60px 60px;opacity:.04}
#gbg::after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 0%,rgba(124,58,237,.1) 0%,transparent 70%),radial-gradient(ellipse 60% 40% at 80% 100%,rgba(0,229,255,.06) 0%,transparent 60%)}
.orb{position:absolute;border-radius:50%;filter:blur(90px);opacity:.15;pointer-events:none}
[data-theme="light"] #gbg{display:none}

/* ═══════════════════════════════════════════════
   LANDING — NAV
═══════════════════════════════════════════════ */
#landing-nav{position:fixed;top:0;left:0;right:0;z-index:50;padding:14px 24px;background:rgba(4,4,15,.82);backdrop-filter:blur(20px);border-bottom:1px solid var(--border)}
[data-theme="light"] #landing-nav{background:rgba(245,245,255,.9)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;max-width:1280px;margin:0 auto}
.nav-logo{display:flex;align-items:center;gap:10px;background:none;border:none}
.nav-logo-icon{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,#7c3aed,#00e5ff);display:flex;align-items:center;justify-content:center;box-shadow:0 0 18px rgba(124,58,237,.4)}
.nav-logo-text{font-family:var(--orb);font-size:.75rem;font-weight:900;letter-spacing:.22em}
.nav-links{display:flex;align-items:center;gap:2px}
.nav-link{padding:7px 14px;border-radius:8px;font-size:.88rem;font-weight:500;color:var(--fg3);background:none;border:none;transition:color .15s,background .15s}
.nav-link:hover,.nav-link.active{color:#a78bfa;background:rgba(124,58,237,.1)}
.nav-actions{display:flex;align-items:center;gap:10px}
.btn-signin{font-size:.88rem;font-weight:600;color:var(--fg3);background:none;border:none;padding:7px 14px;transition:color .15s;border-radius:8px}
.btn-signin:hover{color:#a78bfa;background:rgba(124,58,237,.08)}
.btn-start{padding:8px 18px;border-radius:10px;font-family:var(--orb);font-size:.6rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;background:linear-gradient(90deg,#7c3aed,#5b21b6);color:#fff;border:none;box-shadow:0 0 18px rgba(124,58,237,.35);transition:transform .15s}
.btn-start:hover{transform:scale(1.04)}
.nav-theme{width:32px;height:32px;border-radius:8px;background:var(--surface2);border:1px solid var(--border2);color:var(--fg3);display:flex;align-items:center;justify-content:center;transition:background .15s}
.nav-theme:hover{background:var(--surface3)}
.nav-ham{display:none;background:none;border:none;color:var(--fg3)}
.nav-mobile{display:none;padding:12px 0 6px;border-top:1px solid var(--border2);margin-top:10px}
.nav-mobile.open{display:block}
.nav-mob-link{display:block;width:100%;text-align:left;padding:9px 12px;border-radius:8px;font-size:.92rem;color:var(--fg3);background:none;border:none;transition:color .15s}
.nav-mob-link:hover{color:#a78bfa}
.nav-mob-actions{display:flex;gap:8px;margin-top:10px;padding-top:10px;border-top:1px solid var(--border2)}
@media(max-width:768px){.nav-links,.nav-actions{display:none}.nav-ham{display:flex}}

/* ═══════════════════════════════════════════════
   LANDING — HERO
═══════════════════════════════════════════════ */
#hero{padding:140px 24px 80px}
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;max-width:1280px;margin:0 auto}
.hero-badge{display:inline-flex;align-items:center;gap:7px;padding:6px 14px;border-radius:999px;font-family:var(--orb);font-size:.6rem;font-weight:700;letter-spacing:.28em;text-transform:uppercase;background:rgba(124,58,237,.1);border:1px solid rgba(124,58,237,.28);color:#a78bfa;margin-bottom:28px}
.hero-h1{font-family:var(--orb);font-weight:900;font-size:clamp(2rem,5vw,3.6rem);line-height:1.05;margin-bottom:20px}
.hero-sub{color:var(--fg3);font-size:1.05rem;line-height:1.7;margin-bottom:36px;max-width:500px}
.hero-btns{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:36px}
.btn-primary{display:inline-flex;align-items:center;gap:8px;padding:13px 26px;border-radius:12px;font-family:var(--orb);font-size:.65rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;background:linear-gradient(135deg,#7c3aed,#00e5ff);color:#04040f;border:none;box-shadow:0 0 36px rgba(124,58,237,.38);transition:transform .15s,box-shadow .15s}
.btn-primary:hover{transform:scale(1.04);box-shadow:0 0 56px rgba(124,58,237,.52)}
.btn-outline{display:inline-flex;align-items:center;gap:8px;padding:13px 26px;border-radius:12px;font-family:var(--orb);font-size:.65rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;background:transparent;border:1px solid var(--border);color:#a78bfa;transition:background .15s}
.btn-outline:hover{background:rgba(255,255,255,.04)}
.hero-social{display:flex;align-items:center;gap:18px}
.hero-avatars{display:flex}
.hero-avatars img{width:30px;height:30px;border-radius:50%;border:2px solid var(--bg);margin-left:-7px}
.hero-avatars img:first-child{margin-left:0}
.hero-rating{color:#f59e0b;font-size:12px}
.hero-count{font-size:.75rem;color:var(--fg3)}
.hero-count span{color:#a78bfa}
.hero-right{display:flex;flex-direction:column;gap:16px}
.hero-img-card{position:relative;border-radius:16px;overflow:hidden;border:1px solid var(--border)}
.hero-img-card img{width:100%;height:220px;object-fit:cover;display:block;filter:brightness(.65) saturate(1.4)}
.hero-img-overlay{position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,var(--bg2) 100%)}
.hero-img-info{position:absolute;bottom:14px;left:16px;right:16px}
.hero-img-label{font-family:var(--orb);font-size:.6rem;color:var(--cyan);text-transform:uppercase;letter-spacing:.2em;margin-bottom:5px}
.hero-progress{width:100%;height:3px;background:rgba(255,255,255,.1);border-radius:2px;overflow:hidden}
.hero-progress-fill{height:100%;background:linear-gradient(90deg,#7c3aed,#00e5ff);width:0;transition:width 1.6s ease-out}
.hero-progress-label{font-family:var(--mono);font-size:.6rem;color:var(--fg3);margin-top:4px}
.terminal{background:var(--surface);border:1px solid rgba(0,229,255,.2);border-radius:14px;padding:16px}
.term-bar{display:flex;align-items:center;gap:6px;padding-bottom:12px;border-bottom:1px solid var(--border2);margin-bottom:12px}
.term-dot{width:9px;height:9px;border-radius:50%}
.term-title{font-family:var(--mono);font-size:.58rem;color:var(--fg3);letter-spacing:.2em;margin-left:6px;text-transform:uppercase}
.term-body{min-height:140px}
.term-line{font-family:var(--mono);font-size:.68rem;line-height:1.75;color:#a5b4fc}
.term-line.hi{color:var(--cyan)}
.term-cursor{font-family:var(--mono);font-size:.68rem;color:var(--cyan);animation:blink 1.1s step-end infinite}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:36px}}

/* ═══════════════════════════════════════════════
   LANDING — STATS
═══════════════════════════════════════════════ */
#stats{padding:48px 24px}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:28px;padding:40px 32px;max-width:1024px;margin:0 auto}
.stat-val{font-family:var(--orb);font-weight:900;font-size:clamp(1.8rem,3.5vw,2.6rem);background:linear-gradient(135deg,#c4b5fd,#00e5ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;text-align:center;margin-bottom:4px}
.stat-label{font-size:.72rem;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--fg3);text-align:center}
@media(max-width:600px){.stats-grid{grid-template-columns:1fr 1fr}}

/* ═══════════════════════════════════════════════
   LANDING — FEATURES
═══════════════════════════════════════════════ */
#features{padding:80px 24px}
.section-head{text-align:center;margin-bottom:56px}
.section-badge{display:inline-flex;align-items:center;gap:7px;padding:6px 14px;border-radius:999px;font-family:var(--orb);font-size:.58rem;font-weight:700;letter-spacing:.28em;text-transform:uppercase;background:rgba(0,229,255,.07);border:1px solid rgba(0,229,255,.2);color:var(--cyan);margin-bottom:14px}
.section-h2{font-family:var(--orb);font-weight:900;font-size:clamp(1.7rem,3.5vw,2.6rem);margin-bottom:14px}
.section-p{color:var(--fg3);font-size:.95rem;max-width:480px;margin:0 auto;line-height:1.7}
.feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;max-width:1280px;margin:0 auto}
.feat-card{padding:24px;border-radius:14px;border:1px solid var(--border);background:var(--surface);transition:transform .2s,border-color .2s}
.feat-card:hover{transform:translateY(-3px);border-color:rgba(124,58,237,.4)}
.feat-icon{width:40px;height:40px;border-radius:11px;display:flex;align-items:center;justify-content:center;margin-bottom:16px}
.feat-icon svg{width:18px;height:18px}
.feat-title{font-family:var(--orb);font-size:.82rem;font-weight:700;margin-bottom:10px;letter-spacing:.04em}
.feat-desc{font-size:.9rem;color:var(--fg3);line-height:1.6}
@media(max-width:900px){.feat-grid{grid-template-columns:1fr 1fr}}
@media(max-width:580px){.feat-grid{grid-template-columns:1fr}}

/* ═══════════════════════════════════════════════
   LANDING — PRICING
═══════════════════════════════════════════════ */
#pricing{padding:80px 24px}
.pricing-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;max-width:1280px;margin:0 auto}
.pricing-card{position:relative;border-radius:16px;overflow:hidden}
.pricing-popular-badge{position:absolute;top:-13px;left:50%;transform:translateX(-50%);padding:3px 14px;border-radius:999px;font-family:var(--orb);font-size:.58rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;background:linear-gradient(90deg,#7c3aed,#00e5ff);color:#04040f;white-space:nowrap;z-index:2}
.pricing-inner{padding:22px;height:100%;display:flex;flex-direction:column}
.pricing-name{font-family:var(--orb);font-size:.65rem;font-weight:700;letter-spacing:.28em;text-transform:uppercase;margin-bottom:10px}
.pricing-price{font-family:var(--orb);font-weight:900;font-size:clamp(1.5rem,2.5vw,2rem);color:var(--fg);margin-bottom:3px}
.pricing-price sub{font-size:.85rem;font-weight:400;color:var(--fg3)}
.pricing-divider{border:none;border-top:1px solid var(--border2);margin:14px 0}
.pricing-features{list-style:none;display:flex;flex-direction:column;gap:9px;margin-bottom:20px;flex:1}
.pricing-features li{display:flex;align-items:flex-start;gap:8px;font-size:.85rem}
.pricing-features li svg{width:13px;height:13px;margin-top:3px;flex-shrink:0}
.pricing-features li span{color:var(--fg3)}
.pricing-btn{width:100%;padding:10px;border-radius:11px;font-family:var(--orb);font-size:.58rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;border:none;cursor:pointer;transition:transform .15s}
.pricing-btn:hover{transform:scale(1.025)}
.pricing-btn.solid{background:linear-gradient(90deg,#7c3aed,#00e5ff);color:#04040f}
.pricing-btn.ghost{background:transparent;border:1px solid var(--border);color:#a78bfa}
.pricing-btn.green{background:linear-gradient(135deg,#16a34a,#22c55e);color:#fff}
@media(max-width:1080px){.pricing-grid{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.pricing-grid{grid-template-columns:1fr;max-width:380px;margin:0 auto}}

/* ═══════════════════════════════════════════════
   LANDING — CTA & FOOTER
═══════════════════════════════════════════════ */
#cta{padding:80px 24px}
.cta-box{max-width:680px;margin:0 auto;text-align:center;padding:56px 40px;border-radius:20px;background:var(--surface);border:1px solid var(--border);position:relative;overflow:hidden}
.cta-box::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 50%,rgba(124,58,237,.08) 0%,transparent 70%);pointer-events:none}
.cta-label{font-family:var(--orb);font-size:.58rem;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--cyan);margin-bottom:18px}
.cta-h2{font-family:var(--orb);font-weight:900;font-size:clamp(1.6rem,3.5vw,2.6rem);line-height:1.1;margin-bottom:16px}
.cta-p{color:var(--fg3);font-size:.95rem;line-height:1.7;margin-bottom:32px;max-width:460px;margin-left:auto;margin-right:auto}
.cta-btns{display:flex;flex-wrap:wrap;justify-content:center;gap:14px}
footer{padding:40px 24px;border-top:1px solid var(--border2)}
.footer-inner{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:36px;max-width:1280px;margin:0 auto 36px}
.footer-brand-name{font-family:var(--orb);font-size:.68rem;font-weight:900;letter-spacing:.18em;margin-bottom:10px}
.footer-brand-desc{font-size:.85rem;color:var(--fg3);line-height:1.6}
.footer-col-title{font-family:var(--orb);font-size:.58rem;font-weight:700;letter-spacing:.28em;text-transform:uppercase;color:var(--fg3);margin-bottom:12px}
.footer-links{list-style:none;display:flex;flex-direction:column;gap:8px}
.footer-links button{font-size:.85rem;color:var(--fg3);background:none;border:none;text-align:left;transition:color .15s;padding:0}
.footer-links button:hover{color:#a78bfa}
.footer-bottom{display:flex;justify-content:space-between;align-items:center;padding-top:24px;border-top:1px solid var(--border2);gap:14px;flex-wrap:wrap;max-width:1280px;margin:0 auto}
.footer-copy{font-family:var(--mono);font-size:.65rem;color:var(--fg3)}
.footer-status{display:flex;align-items:center;gap:6px;font-family:var(--mono);font-size:.65rem;color:var(--fg3)}
@media(max-width:768px){.footer-inner{grid-template-columns:1fr 1fr}}
@media(max-width:480px){.footer-inner{grid-template-columns:1fr}}

/* ═══════════════════════════════════════════════
   MODAL SHARED
═══════════════════════════════════════════════ */
.modal-overlay{display:none;position:fixed;inset:0;z-index:200;background:rgba(4,4,15,.88);backdrop-filter:blur(10px);align-items:center;justify-content:center;padding:16px}
[data-theme="light"] .modal-overlay{background:rgba(100,80,200,.15)}
.modal-overlay.open{display:flex}
.modal-box{width:100%;max-width:460px;border-radius:20px;overflow:hidden;position:relative;animation:slideUp .25s ease-out}
.modal-close{position:absolute;top:14px;right:14px;width:30px;height:30px;border-radius:8px;background:var(--surface2);border:1px solid var(--border2);color:var(--fg3);display:flex;align-items:center;justify-content:center;z-index:2;transition:background .15s}
.modal-close:hover{background:var(--surface3)}
.modal-head{padding:28px 28px 0;text-align:center}
.modal-icon{width:50px;height:50px;border-radius:14px;background:linear-gradient(135deg,#7c3aed,#00e5ff);display:flex;align-items:center;justify-content:center;margin:0 auto 14px}
.modal-icon svg{width:21px;height:21px}
.modal-kicker{font-family:var(--orb);font-size:.55rem;font-weight:700;letter-spacing:.32em;text-transform:uppercase;color:var(--cyan);margin-bottom:6px}
.modal-title{font-family:var(--orb);font-weight:900;font-size:1.25rem;margin-bottom:6px}
.modal-sub{font-size:.88rem;color:var(--fg3);line-height:1.5}
.modal-body{padding:22px 28px 28px;display:flex;flex-direction:column;gap:13px}
.mf{display:flex;flex-direction:column;gap:5px}
.mf label{font-family:var(--orb);font-size:.55rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#a78bfa}
.mf input{padding:11px 14px;border-radius:10px;font-size:.92rem;background:var(--surface2);border:1px solid var(--border);color:var(--fg);outline:none;transition:border-color .15s,box-shadow .15s;width:100%}
.mf input:focus{border-color:rgba(124,58,237,.6);box-shadow:0 0 0 3px rgba(124,58,237,.12)}
.mf input::placeholder{color:var(--fg3)}
.mrow{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.merr{font-size:.82rem;color:#f87171;background:rgba(239,68,68,.07);border:1px solid rgba(239,68,68,.18);border-radius:8px;padding:9px 13px;display:none}
.merr.show{display:block}
.mbtn{width:100%;padding:13px;border-radius:12px;font-family:var(--orb);font-size:.65rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;background:linear-gradient(135deg,#7c3aed,#00e5ff);color:#04040f;border:none;box-shadow:0 0 28px rgba(124,58,237,.3);transition:transform .15s,box-shadow .15s}
.mbtn:hover{transform:scale(1.02);box-shadow:0 0 44px rgba(124,58,237,.48)}
.mbtn:disabled{opacity:.6;cursor:not-allowed;transform:none}
.mbtn.green{background:linear-gradient(135deg,#16a34a,#22c55e);box-shadow:0 0 28px rgba(34,197,94,.25)}
.mnote{font-size:.82rem;color:var(--fg3);text-align:center}
.mnote span{color:#a78bfa;cursor:pointer;text-decoration:underline}
.mdivider{display:flex;align-items:center;gap:10px;color:var(--fg3);font-size:.8rem}
.mdivider::before,.mdivider::after{content:'';flex:1;height:1px;background:var(--border2)}
.mperks{background:rgba(0,229,255,.04);border:1px solid rgba(0,229,255,.12);border-radius:11px;padding:12px 14px;display:flex;flex-direction:column;gap:7px}
.mperk{display:flex;align-items:center;gap:9px;font-size:.83rem;color:var(--fg3)}
.mperk svg{width:13px;height:13px;flex-shrink:0;color:var(--cyan)}
.mforgot{text-align:right;font-size:.8rem;color:var(--fg3)}
.mforgot span{color:#a78bfa;cursor:pointer;text-decoration:underline}
.modal-success{padding:32px 28px 28px;text-align:center;display:none}
.modal-success.show{display:block}
.modal-form.hide{display:none}
.success-icon{width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,rgba(0,229,255,.12),rgba(124,58,237,.12));border:1px solid rgba(0,229,255,.28);display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
.success-icon svg{width:26px;height:26px;color:var(--cyan)}
.success-title{font-family:var(--orb);font-weight:900;font-size:1.15rem;margin-bottom:8px}
.success-text{font-size:.9rem;color:var(--fg3);line-height:1.6;margin-bottom:20px}
.success-spinner{display:flex;align-items:center;justify-content:center;gap:10px;font-size:.82rem;color:var(--fg3);margin-bottom:20px}
.spinner{width:18px;height:18px;border-radius:50%;border:2px solid var(--border);border-top-color:var(--cyan);animation:spin .7s linear infinite}

/* ═══════════════════════════════════════════════
   DEMO MODAL
═══════════════════════════════════════════════ */
#demo-modal{display:none;position:fixed;inset:0;z-index:200;background:rgba(4,4,15,.86);backdrop-filter:blur(8px);align-items:center;justify-content:center;padding:16px}
#demo-modal.open{display:flex}
.demo-box{width:100%;max-width:540px;max-height:78vh;display:flex;flex-direction:column;border-radius:18px;overflow:hidden;border:1px solid rgba(0,229,255,.22)}
.demo-header{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;background:var(--surface);border-bottom:1px solid var(--border2);flex-shrink:0}
.demo-header-left{display:flex;align-items:center;gap:10px}
.demo-avatar{width:30px;height:30px;border-radius:8px;background:linear-gradient(135deg,#7c3aed,#00e5ff);display:flex;align-items:center;justify-content:center}
.demo-title{font-family:var(--orb);font-size:.68rem;font-weight:700;color:var(--cyan)}
.demo-status{display:flex;align-items:center;gap:5px;font-family:var(--mono);font-size:.6rem;color:var(--fg3);margin-top:2px}
.demo-close{width:28px;height:28px;border-radius:7px;background:var(--surface2);border:1px solid var(--border2);color:var(--fg3);display:flex;align-items:center;justify-content:center;transition:background .15s}
.demo-close:hover{background:var(--surface3)}
.demo-messages{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:14px;background:var(--bg2);min-height:0}
.dmsg{display:flex}
.dmsg.user{justify-content:flex-end}
.dmsg.ai{justify-content:flex-start}
.dbubble{max-width:82%;padding:10px 14px;border-radius:12px;font-size:.88rem;line-height:1.5}
.dmsg.user .dbubble{background:linear-gradient(135deg,#7c3aed,#5b21b6);color:#fff}
.dmsg.ai .dbubble{background:var(--surface);border:1px solid rgba(0,229,255,.16);color:#a5b4fc}
.dai-label{font-family:var(--orb);font-size:.55rem;color:var(--cyan);display:block;margin-bottom:4px}
.typing-dots{display:flex;gap:5px;padding:12px 14px}
.typing-dots span{width:5px;height:5px;border-radius:50%;background:var(--cyan);animation:bnc .9s ease-in-out infinite}
.typing-dots span:nth-child(2){animation-delay:.18s}
.typing-dots span:nth-child(3){animation-delay:.36s}
@keyframes bnc{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
.demo-input-area{padding:12px 14px;background:var(--surface);border-top:1px solid var(--border2);display:flex;gap:10px;flex-shrink:0}
.demo-input{flex:1;padding:9px 13px;border-radius:9px;font-size:.88rem;background:var(--surface2);border:1px solid var(--border);color:var(--fg);outline:none;transition:border-color .15s}
.demo-input:focus{border-color:rgba(0,229,255,.4)}
.demo-send{width:34px;height:34px;border-radius:8px;background:linear-gradient(135deg,#7c3aed,#00e5ff);border:none;display:flex;align-items:center;justify-content:center;flex-shrink:0}

/* ═══════════════════════════════════════════════
   TOAST
═══════════════════════════════════════════════ */
#toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(16px);background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:10px 18px;font-size:.88rem;color:var(--fg);display:flex;align-items:center;gap:9px;opacity:0;transition:opacity .25s,transform .25s;z-index:999;pointer-events:none;white-space:nowrap}
#toast svg{width:14px;height:14px;color:var(--cyan);flex-shrink:0}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ═══════════════════════════════════════════════
   APP SHELL
═══════════════════════════════════════════════ */
#app{display:none;position:fixed;inset:0;z-index:100;height:100dvh}
#app.active{display:flex}
.app-shell{display:flex;width:100%;height:100%;min-height:0;overflow:hidden}
.sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(4,4,15,.6);z-index:40;backdrop-filter:blur(4px)}
.sidebar-overlay.open{display:block}

/* ═══════════════════════════════════════════════
   SIDEBAR
═══════════════════════════════════════════════ */
.sidebar{width:260px;flex-shrink:0;background:var(--surface);border-right:1px solid var(--border2);display:flex;flex-direction:column;height:100%;overflow:hidden;transition:transform .25s}
@media(max-width:768px){.sidebar{position:fixed;left:0;top:0;bottom:0;z-index:50;transform:translateX(-100%)}.sidebar.open{transform:translateX(0)}}
.sidebar-top{display:flex;align-items:center;justify-content:space-between;padding:16px 14px;border-bottom:1px solid var(--border2)}
.sidebar-logo{display:flex;align-items:center;gap:8px}
.sidebar-logo-icon{width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#7c3aed,#00e5ff);display:flex;align-items:center;justify-content:center}
.sidebar-logo-text{font-family:var(--orb);font-size:.68rem;font-weight:900;letter-spacing:.2em}
.sidebar-top-actions{display:flex;gap:4px}
.icon-btn{width:30px;height:30px;border-radius:8px;background:none;border:1px solid var(--border2);color:var(--fg3);display:flex;align-items:center;justify-content:center;transition:background .15s,color .15s}
.icon-btn:hover{background:var(--surface2);color:var(--fg)}
.sidebar-new-chat{display:flex;align-items:center;gap:8px;width:calc(100% - 28px);margin:12px 14px;padding:10px 14px;border-radius:10px;font-family:var(--orb);font-size:.6rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;background:linear-gradient(135deg,#7c3aed,#00e5ff);color:#04040f;border:none;box-shadow:0 0 18px rgba(124,58,237,.3);transition:transform .15s}
.sidebar-new-chat:hover{transform:scale(1.02)}
.sidebar-section-label{padding:10px 16px 4px;font-family:var(--orb);font-size:.55rem;font-weight:700;letter-spacing:.24em;text-transform:uppercase;color:var(--fg3)}
.sidebar-chats{flex:1;overflow-y:auto;padding:4px 8px}
.chat-item{display:flex;align-items:center;gap:8px;width:100%;padding:9px 10px;border-radius:9px;background:none;border:none;color:var(--fg3);font-size:.85rem;text-align:left;transition:background .15s,color .15s;cursor:pointer}
.chat-item:hover{background:var(--surface2);color:var(--fg)}
.chat-item.active{background:rgba(124,58,237,.12);color:#a78bfa}
.chat-item-icon{width:14px;height:14px;flex-shrink:0}
.chat-item-text{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chat-item-time{font-size:.72rem;color:var(--fg3);flex-shrink:0}
.sidebar-user{display:flex;align-items:center;gap:10px;padding:14px;border-top:1px solid var(--border2)}
.user-avatar{width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,#7c3aed,#00e5ff);display:flex;align-items:center;justify-content:center;font-family:var(--orb);font-size:.62rem;font-weight:900;color:#04040f;flex-shrink:0}
.user-info{flex:1;overflow:hidden}
.user-name{font-weight:600;font-size:.88rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.user-plan{font-size:.72rem;color:var(--fg3)}
.user-menu-btn{width:26px;height:26px;border-radius:7px;background:none;border:1px solid var(--border2);color:var(--fg3);display:flex;align-items:center;justify-content:center;transition:background .15s}
.user-menu-btn:hover{background:var(--surface2)}

/* ═══════════════════════════════════════════════
   CHAT MAIN
═══════════════════════════════════════════════ */
.chat-main{flex:1;display:flex;flex-direction:column;height:100%;min-height:0;overflow:hidden;background:var(--bg2)}
.chat-topbar{display:flex;align-items:center;justify-content:space-between;padding:12px 18px;border-bottom:1px solid var(--border2);background:var(--surface);flex-shrink:0}
.chat-topbar-left,.chat-topbar-right{display:flex;align-items:center;gap:10px}
.sidebar-toggle{width:32px;height:32px;border-radius:8px;background:none;border:1px solid var(--border2);color:var(--fg3);display:flex;align-items:center;justify-content:center;transition:background .15s}
.sidebar-toggle:hover{background:var(--surface2)}
.chat-model-selector{display:flex;align-items:center;gap:7px;font-family:var(--orb);font-size:.62rem;font-weight:700;letter-spacing:.12em;color:#a78bfa}
.chat-model-dot{width:7px;height:7px;border-radius:50%;background:var(--cyan);animation:pulse 2s ease-in-out infinite}
.chat-messages{flex:1;overflow-y:auto;padding:20px;display:flex;flex-direction:column;gap:18px;min-height:0}
.chat-welcome{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 20px;text-align:center;gap:16px;min-height:0;overflow-y:auto}
.welcome-icon{width:60px;height:60px;border-radius:18px;background:linear-gradient(135deg,#7c3aed,#00e5ff);display:flex;align-items:center;justify-content:center;box-shadow:0 0 40px rgba(124,58,237,.35)}
.welcome-title{font-family:var(--orb);font-weight:900;font-size:clamp(1.4rem,3vw,2rem)}
.welcome-sub{color:var(--fg3);font-size:.95rem;max-width:520px;line-height:1.7}
.welcome-prompts{display:grid;grid-template-columns:1fr 1fr;gap:10px;max-width:560px;width:100%}
.prompt-btn{padding:14px 16px;border-radius:12px;background:var(--surface);border:1px solid var(--border);color:var(--fg3);text-align:left;font-size:.85rem;line-height:1.5;transition:border-color .15s,background .15s}
.prompt-btn:hover{border-color:rgba(124,58,237,.4);background:var(--surface2);color:var(--fg)}
.prompt-btn strong{display:block;font-family:var(--orb);font-size:.6rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#a78bfa;margin-bottom:4px}
@media(max-width:480px){.welcome-prompts{grid-template-columns:1fr}}

/* ═══════════════════════════════════════════════
   CHAT MESSAGES
═══════════════════════════════════════════════ */
.chat-msg{display:flex;gap:10px;animation:fadeIn .25s ease-out}
.chat-msg.user-msg{flex-direction:row-reverse}
.msg-avatar{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-family:var(--orb);font-size:.62rem;font-weight:900;flex-shrink:0}
.ai-av{background:linear-gradient(135deg,#7c3aed,#00e5ff);color:#04040f}
.user-av{background:var(--surface2);border:1px solid var(--border);color:#a78bfa}
.msg-content{max-width:72%;display:flex;flex-direction:column;gap:4px}
.chat-msg.user-msg .msg-content{align-items:flex-end}
.msg-sender{font-size:.75rem;font-weight:600;color:var(--fg3)}
.msg-bubble{padding:12px 16px;border-radius:14px;font-size:.92rem;line-height:1.65;word-break:break-word}
.ai-msg .msg-bubble{background:var(--surface);border:1px solid var(--border2)}
.user-msg .msg-bubble{background:linear-gradient(135deg,#7c3aed,#5b21b6);color:#fff;border-bottom-right-radius:4px}
.msg-bubble img{max-width:220px;border-radius:10px;margin-top:8px;display:block}
.msg-time{font-size:.7rem;color:var(--fg3)}
.typing-dots-inline{display:flex;gap:4px}
.typing-dots-inline span{width:5px;height:5px;border-radius:50%;background:var(--cyan);animation:bnc .9s ease-in-out infinite}
.typing-dots-inline span:nth-child(2){animation-delay:.18s}
.typing-dots-inline span:nth-child(3){animation-delay:.36s}

/* ═══════════════════════════════════════════════
   CHAT INPUT
═══════════════════════════════════════════════ */
.chat-input-wrap{padding:12px 16px 16px;flex-shrink:0;background:var(--bg2)}
.file-chip{display:none;align-items:center;gap:8px;padding:5px 10px 5px 12px;background:rgba(124,58,237,.12);border:1px solid rgba(124,58,237,.3);border-radius:8px;font-size:.8rem;color:#a78bfa;margin-bottom:6px;max-width:100%;overflow:hidden}
.file-chip.show{display:flex}
.file-chip-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;font-family:var(--mono);font-size:.75rem}
.file-chip-rm{background:none;border:none;color:#a78bfa;padding:0 2px;line-height:1;opacity:.7;flex-shrink:0;font-size:.9rem}
.file-chip-rm:hover{opacity:1}
.chat-input-box{display:flex;flex-direction:column;gap:10px;background:var(--surface);border:1px solid var(--border);border-radius:26px;padding:14px 16px 12px;transition:border-color .15s}
.chat-input-box:focus-within{border-color:rgba(124,58,237,.5)}
.chat-textarea{flex:0 1 auto;background:none;border:none;outline:none;resize:none;font-size:1rem;line-height:1.5;color:var(--fg);max-height:200px;min-height:24px;overflow-y:auto;word-break:break-word;white-space:pre-wrap;width:100%}
.chat-textarea::placeholder{color:var(--fg3)}
.chat-input-row2{display:flex;align-items:center;justify-content:space-between;gap:8px}
.chat-row2-left{display:flex;align-items:center;gap:8px}
.chat-row2-right{display:flex;align-items:center;gap:8px}
.chat-plus-btn{width:34px;height:34px;border-radius:50%;background:var(--surface2);border:1px solid var(--border2);color:var(--fg3);display:flex;align-items:center;justify-content:center;transition:background .15s,color .15s;flex-shrink:0}
.chat-plus-btn:hover{background:rgba(124,58,237,.15);color:#a78bfa;border-color:rgba(124,58,237,.3)}
.model-pill{display:flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;background:var(--surface2);border:1px solid var(--border2);color:var(--fg);font-size:.85rem;font-weight:500;transition:background .15s;flex-shrink:0;white-space:nowrap}
.model-pill:hover{background:var(--surface3)}
.chat-attach{width:34px;height:34px;border-radius:50%;background:var(--surface2);border:1px solid var(--border2);color:var(--fg3);display:flex;align-items:center;justify-content:center;transition:background .15s,color .15s;flex-shrink:0}
.chat-attach:hover{background:rgba(124,58,237,.15);color:#a78bfa;border-color:rgba(124,58,237,.3)}
.chat-send{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#7c3aed,#00e5ff);border:none;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:transform .15s,box-shadow .15s}
.chat-send:hover{transform:scale(1.06);box-shadow:0 0 18px rgba(124,58,237,.4)}
.chat-send:disabled{opacity:1;transform:none;background:var(--surface3);cursor:not-allowed}
.chat-send.busy{background:var(--surface3)}
.chat-voice-btn{width:34px;height:34px;border-radius:50%;background:#111;border:none;color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:transform .15s}
.chat-voice-btn:hover{transform:scale(1.06)}
[data-theme="light"] .chat-voice-btn{background:#111}
.chat-hint{font-size:.72rem;color:var(--fg3);text-align:center;margin-top:8px}

/* ══════════════════════════════════════════════
   MOBILE NAV
══════════════════════════════════════════════ */
@media(max-width:768px){
  .chat-input-wrap{padding:8px 10px 14px}
  .msg-content{max-width:88%}
  .welcome-title{font-size:1.3rem}
}
</style>
</head>
<body>

<div id="gbg">
  <div class="orb" style="width:600px;height:600px;background:#7c3aed;top:-160px;right:-100px"></div>
  <div class="orb" style="width:400px;height:400px;background:#00e5ff;top:40%;left:-120px"></div>
  <div class="orb" style="width:480px;height:480px;background:#7c3aed;bottom:-60px;left:22%"></div>
</div>

<!-- ══════════════════════════════════════════════════════════
     LANDING PAGE
══════════════════════════════════════════════════════════ -->
<div id="landing">

  <!-- NAV -->
  <nav id="landing-nav">
    <div class="nav-inner">
      <button class="nav-logo" onclick="scr('hero')">
        <div class="nav-logo-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#04040f" stroke-width="2.5" stroke-linecap="round" style="width:16px;height:16px"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg>
        </div>
        <span class="nav-logo-text gth">ECLIPSEVEX</span>
      </button>
      <div class="nav-links">
        <button class="nav-link active" onclick="scr('hero')">Home</button>
        <button class="nav-link" onclick="scr('features')">Features</button>
        <button class="nav-link" onclick="scr('pricing')">Pricing</button>
        <button class="nav-link" onclick="toast('Documentation coming soon!')">Docs</button>
      </div>
      <div class="nav-actions">
        <button class="nav-theme" onclick="toggleTheme()" title="Toggle theme" id="theme-btn">
          <svg id="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="width:15px;height:15px"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </button>
        <button class="btn-signin" onclick="openSignin()">Sign In</button>
        <button class="btn-start" onclick="openSignup()">Start Free</button>
      </div>
      <button class="nav-ham" id="nav-ham" onclick="toggleMobileNav()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="width:22px;height:22px"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
    <div class="nav-mobile" id="nav-mobile">
      <button class="nav-mob-link" onclick="scr('hero');toggleMobileNav()">Home</button>
      <button class="nav-mob-link" onclick="scr('features');toggleMobileNav()">Features</button>
      <button class="nav-mob-link" onclick="scr('pricing');toggleMobileNav()">Pricing</button>
      <div class="nav-mob-actions">
        <button class="btn-signin" style="flex:1;border:1px solid var(--border);border-radius:10px" onclick="openSignin();toggleMobileNav()">Sign In</button>
        <button class="btn-start" style="flex:1" onclick="openSignup();toggleMobileNav()">Start Free</button>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section id="hero" style="padding:140px 24px 80px">
    <div class="hero-grid">
      <div>
        <div class="hero-badge"><span class="dot"></span>Next-Gen AI — v4.2 Live</div>
        <h1 class="hero-h1">ECLIPSE THE<br><span class="gt">LIMITS</span> OF<br>INTELLIGENCE</h1>
        <p class="hero-sub">ECLIPSEVEX AI delivers sovereign-grade intelligence at the speed of thought — built for enterprises demanding uncompromising performance, security, and scale.</p>
        <div class="hero-btns">
          <button class="btn-primary" onclick="openSignup()">Start for Free <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="width:14px;height:14px"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button>
          <button class="btn-outline" onclick="openDemo()"><svg viewBox="0 0 24 24" fill="currentColor" style="width:13px;height:13px"><polygon points="5 3 19 12 5 21 5 3"/></svg> Live Demo</button>
        </div>
        <div class="hero-social">
          <div class="hero-avatars">
            <img src="https://i.pravatar.cc/40?img=11" alt=""/><img src="https://i.pravatar.cc/40?img=22" alt=""/><img src="https://i.pravatar.cc/40?img=33" alt=""/><img src="https://i.pravatar.cc/40?img=44" alt=""/>
          </div>
          <div>
            <div class="hero-rating">★★★★★</div>
            <p class="hero-count">Trusted by <span>12,000+</span> teams</p>
          </div>
        </div>
      </div>
      <div class="hero-right">
        <div class="hero-img-card">
          <img src="https://images.unsplash.com/photo-1620712943543-bcc4688e7485?w=700&h=300&fit=crop&q=85" alt="AI"/>
          <div class="hero-img-overlay"></div>
          <div class="hero-img-info">
            <div class="hero-img-label">Neural Processing Core</div>
            <div class="hero-progress"><div class="hero-progress-fill" id="hero-progress"></div></div>
