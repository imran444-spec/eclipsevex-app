import requests as req_lib
from flask import request, jsonify, send_file
import io, os

@app.route('/api/generate_image', methods=['POST'])
def generate_image():
    data = request.get_json()
    prompt = data.get('prompt', '')
    seed = data.get('seed', 42)
    url = f"https://image.pollinations.ai/prompt/{req_lib.utils.quote(prompt)}?width=768&height=768&seed={seed}&nologo=true"
    resp = req_lib.get(url, timeout=60)
    if resp.status_code == 200:
        return send_file(io.BytesIO(resp.content), mimetype='image/jpeg')
    return jsonify({'error': 'Generation failed'}), 500

import re as _re_dl

@app.route('/api/download_apk/<build_id>', methods=['GET'])
def download_apk(build_id):
    # build_id must be exactly the 8-char hex uuid prefix build_apk_v2 generates
    # -- reject anything else to prevent path traversal.
    if not _re_dl.fullmatch(r'[0-9a-f]{8}', build_id):
        return jsonify({'error': 'Invalid build id'}), 400
    apk_path = os.path.join(
        '/root/ECLIPSEVEX-AI/builds', build_id,
        'app/build/outputs/apk/debug/app-debug.apk'
    )
    if not os.path.isfile(apk_path):
        return jsonify({'error': 'APK not found'}), 404
    return send_file(
        apk_path,
        mimetype='application/vnd.android.package-archive',
        as_attachment=True,
        download_name=f'app-{build_id}.apk'
    )

