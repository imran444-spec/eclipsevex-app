@app.route('/chat', methods=['POST'])
def chat_file():
    message = request.form.get('message', '').strip()
    try:
        history = json.loads(request.form.get('history', '[]'))
    except Exception:
        history = []
    if request.files.get('image'):
        img_file = request.files['image']
        from vision.ocr import read_image_text
        extracted = read_image_text(img_file.read())

        # Reject low-confidence OCR instead of feeding garbled text to the
        # model, which will otherwise confidently fabricate an answer around
        # corrupted words rather than admitting it couldn't read the image.
        words = extracted.split()
        if len(words) < 8:
            return jsonify({
                'reply': ("I couldn't read enough clear text from that image "
                          "(the extracted text was too short or unclear). "
                          "Could you paste the error message as text instead, "
                          "or send a higher-resolution screenshot?"),
                'source': 'vision'
            })

        combined = f"{message}\n\n[Image text — may contain OCR errors, verify before acting on specific names/values]: {extracted}" if message else f"Describe/fix this (OCR text, may contain errors): {extracted}"
        reply, source = engine.answer(combined, history=history)
        return jsonify({'reply': reply, 'source': 'vision'})
    if not message:
        return jsonify({'error': 'No message'}), 400
    try:
        reply, source = engine.answer(message, history=history)
        return jsonify({'reply': reply, 'source': source})
    except Exception as e:
        return jsonify({'reply': 'Error. Please try again.', 'source': 'error'}), 500
