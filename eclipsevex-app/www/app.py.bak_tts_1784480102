@app.route('/api/chat/stream', methods=['POST'])
def chat_stream():
    import json as _json
    data = request.get_json(force=True, silent=True) or {}
    message = (data.get('message') or '').strip()
    history = data.get('history') or []
    if not message:
        return jsonify({'error': 'No message'}), 400
    from core.hybrid_engine import STATUS_PREFIX
    def generate():
        try:
            for token in engine.answer_stream(message, history=history):
                if token.startswith(STATUS_PREFIX):
                    status_text = token[len(STATUS_PREFIX):]
                    yield f"data: {_json.dumps({'status': status_text})}\n\n"
                else:
                    yield f"data: {_json.dumps({'t': token})}\n\n"
        except Exception as e:
            yield f"data: {_json.dumps({'t': 'Error. Please try again.'})}\n\n"
        yield f"data: {_json.dumps({'done': True})}\n\n"
    return Response(stream_with_context(generate()),
                    mimetype='text/event-stream',
                    headers={'Cache-Control':'no-cache','X-Accel-Buffering':'no'})

